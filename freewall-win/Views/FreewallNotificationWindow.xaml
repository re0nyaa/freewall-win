<Window x:Class="freewall_win.Views.FreewallNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="freewall notification"
        Height="84" Width="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Storyboard x:Key="ShowAnim">
            <DoubleAnimation Storyboard.TargetName="NotificationCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="CardTransform"
                             Storyboard.TargetProperty="Y"
                             From="25" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HideAnim">
            <DoubleAnimation Storyboard.TargetName="NotificationCard"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="CardTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="20" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Border x:Name="NotificationCard"
                Background="#EE181A1F"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Margin="4"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTransform" Y="25"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>

            <Grid Margin="12,10,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status Shield Icon -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="#18FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="IconBadge" Symbol="ShieldCheckmark24" FontSize="22" Foreground="#10B981" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- Text Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeBorder" Background="#2210B981" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                            <TextBlock x:Name="BadgeTxt" Text="보호 상태" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981"/>
                        </Border>
                        <TextBlock x:Name="TitleTxt" Text="freewall" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock x:Name="MsgTxt" Text="보호가 활성화되었습니다."
                               FontSize="11.5" Foreground="#D4D4D8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
